# Public/client-safe Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Canonical public MGP origin used by browser-side auth redirects.
VITE_SITE_URL=https://mgprofile.online

# Public app origin used by server-side OAuth/OpenID flows.
PUBLIC_APP_URL=https://mgprofile.online

# Server-side Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# External game/account provider secrets — server-side only
STEAM_WEB_API_KEY=
RIOT_API_KEY=
RIOT_RSO_CLIENT_ID=
RIOT_RSO_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Strong age-assurance provider — server-side only
# Raw identity documents should be processed by the verifier and not exposed to the client or normal profile tables.
AGE_ASSURANCE_PROVIDER=
AGE_ASSURANCE_API_KEY=
AGE_ASSURANCE_WEBHOOK_SECRET=

# NEXUS inference providers — server-side only.
# Consumer subscriptions are not API credentials. Use keys created in each provider's developer console.
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Admin/development routing. Unconfigured providers are skipped automatically.
NEXUS_PROVIDER_ORDER=openai,gemini,groq,openrouter,anthropic
# Guest routing prefers providers that currently offer official free inference tiers.
NEXUS_GUEST_PROVIDER_ORDER=gemini,groq,openrouter,openai,anthropic

NEXUS_OPENAI_MODEL=gpt-5.6-sol
NEXUS_GEMINI_MODEL=gemini-3.8-flash
NEXUS_GROQ_MODEL=openai/gpt-oss-120b
NEXUS_OPENROUTER_MODEL=openrouter/free
NEXUS_ANTHROPIC_MODEL=claude-sonnet-4-6

# Anonymous NEXUS trial — server-side only.
# Legacy deployments may still define this secret; the current guest quota is enforced in Supabase.
NEXUS_GUEST_SESSION_SECRET=

# NEXUS administrative tool bridges — server-side only.
# GitHub: prefer a repository-scoped GitHub App rather than a broad personal token.
NEXUS_GITHUB_APP_ID=
NEXUS_GITHUB_INSTALLATION_ID=
NEXUS_GITHUB_PRIVATE_KEY=
# Supabase Management API: use a project-limited management token/OAuth grant when available.
SUPABASE_MANAGEMENT_ACCESS_TOKEN=
# Lovable is connected through its official MCP OAuth flow (https://mcp.lovable.dev).
# OAuth access/refresh tokens must be stored server-side/encrypted after authorization, never in VITE_* variables.

# AdSense manual ad-unit IDs (optional).
# Leave blank to use Google Auto Ads with the global ca-pub loader.
VITE_ADSENSE_RAIL_SLOT=
VITE_ADSENSE_LEADERBOARD_SLOT=
VITE_ADSENSE_RECTANGLE_SLOT=
VITE_ADSENSE_FLUID_SLOT=
